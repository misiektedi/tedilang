main {
    let: int counter = 0;
    let: int sum = 0;
    let: string name = "tester";

    output("Starting stress test...");


    while: counter <= 10 {
        if: counter < 5 {
            output("Counter is small: " ~ counter)
        } else {
            output("Counter is big: " ~ counter);
        };

        counter = counter + 1;
    };

    exit();
}