main {
    let: int counter = 1;
    let: int sum = 0;
    let: string name = "tester";

    output("Starting stress test...");

    while: counter < 100 {
        counter = counter + 1;
        sum = sum + counter;

        if: counter < 10 {
            output("Counter is small: " ~ counter);
        } else {
            output("Counter is " ~ counter);
        };

    };

    exit();
}